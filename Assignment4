console.log("-- Multiplication Table of 5 --");
for (let i = 1; i <= 5; i++) {
    console.log("5 x " + i + " = " + (5 * i));
}
console.log("\n-- First number > 10 divisible by 6 --");
let num = 11;
while (true) {
    if (num > 10 && num % 6 === 0) {
        console.log("Found: " + num);
        break;
    }
    num++;
}
let count = 0;
do {
    count++;
    if (count === 2 || count === 4) {
        continue;
    }
    console.log("Count: " + count);
} while (count < 5);
